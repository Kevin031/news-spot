NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/app/data/news.db
WEB_DIST_PATH=/app/apps/web/dist
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# 可选。配置后提升 GitHub API 限额；失效时会自动降级为匿名请求。
GITHUB_TOKEN=

WORKER_RUN_TIMES=09:00,15:00
WORKER_TIME_ZONE=Asia/Shanghai
SOURCE_HACKERNEWS_ENABLED=true
SOURCE_V2EX_ENABLED=true
SOURCE_GITHUB_ENABLED=true
SOURCE_BBC_ENABLED=true
SOURCE_ITHOME_ENABLED=true
SOURCE_BILIBILI_ENABLED=true
SOURCE_DEVTO_ENABLED=true
SOURCE_STACKOVERFLOW_ENABLED=true
SOURCE_LOBSTERS_ENABLED=true
SOURCE_SSPAI_ENABLED=true
SOURCE_SOLIDOT_ENABLED=true
SOURCE_TECHCRUNCH_ENABLED=true
SOURCE_NPR_WORLD_ENABLED=true
SOURCE_MARKETWATCH_ENABLED=true
SOURCE_ARSTECHNICA_ENABLED=true
SOURCE_AIHOT_SELECTED_ENABLED=false
SOURCE_AIHOT_TOPICS_ENABLED=false
