# 默认读取 ~/.config/news-spot/deploy.env。
# SSH alias 复用 ~/.ssh/config 中的腾讯云配置。
DEPLOY_SSH_TARGET=tencent-cloud

# 远端部署目录与应用端口。
DEPLOY_PATH=/opt/news-spot
DEPLOY_APP_PORT=20245
DEPLOY_DOMAIN=hot-spots.kevinlau.cn
DEPLOY_KEEP_RELEASES=5

# 可选：Docker Hub 直连不稳定时，使用可信镜像加速地址。
# DEPLOY_NODE_IMAGE=dockerproxy.net/library/node:22-bookworm-slim

# 可选：npm 官方源直连不稳定时，使用 npm 镜像源。
# DEPLOY_NPM_REGISTRY=https://registry.npmmirror.com

# 可选：将本地生产环境变量上传到远端 shared/.env。
# DEPLOY_ENV_FILE=.env.production

# 可选：部署后让远端执行现有反向代理的安全重载命令。
# DEPLOY_PROXY_RELOAD_COMMAND=sudo nginx -t && sudo systemctl reload nginx

# 域名尚未接入反向代理时可临时跳过公网检查。
DEPLOY_SKIP_PUBLIC_CHECK=false
